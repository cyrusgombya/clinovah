- var countdown       = true; 
- var password_hide         = true;
doctype html
html(lang='en')
  include ../../components/header-files
  body
    .loader-wrapper
      .text-center
        img.img-fluid(src='../assets/images/Loader.gif' alt='loader')
      .text-animation
        svg
          text(x='50%' y='50%' dy='.35em' text-anchor='middle')
            | Physic template
    .container-fluid
        .row.align-items-center 
            .col-xl-6.col-5 
                .patient-login
                    .login-title 
                        h4 Welcome To Physic
                        p Create New Account
                    .login-form 
                        form.row.g-3
                            .col-12 
                                label Enter Your Name
                                input.form-control(type='email' placeholder='Enter Your Name')
                            .col-12 
                                label Enter Your mail
                                input.form-control(type='email' placeholder='Name@example.com')
                            .col-12 
                                label Password 
                                .form-input.position-relative
                                    input.form-control(type='password', name='login[password]', required='' placeholder="*********")
                                    .show-hide
                                        span.show
                            .col-12
                                .forgot-box
                                    .remember-box
                                        input.custom-checkbox#category1.me-2(type="checkbox", name="text")
                                        label(for="category1") I agree with 
                                            span Terms 
                                            | and 
                                            span Privacy
                            .col-12 
                                button.btn.login.sub-btn.sm(type='submit' data-bs-dismiss="modal" aria-label="Close") Sign Up
                    .other-login 
                        h6 OR
                    .login-button 
                        ul 
                            li 
                                a(href="https://www.google.com/" target="_blank") 
                                    i.ri-google-fill
                            li 
                                a(href="https://www.facebook.com/" target="_blank")
                                    i.ri-facebook-fill
                            li 
                                a(href="https://www.facebook.com/" target="_blank")
                                    i.ri-instagram-line
                            li 
                                a(href="https://www.facebook.com/" target="_blank")
                                    i.ri-twitter-x-line
                    .other-login
                    .sign-up-box 
                        p Already have an account?
                        a(href="login.html") Log In 
            .col-xl-6.col-lg-7.p-0
                .patient-img 
                    img.img-fluid(src="../assets/images/login/1.jpg", alt="")

    include ../../components/footer-files