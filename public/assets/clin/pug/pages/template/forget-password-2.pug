- var popper                = true;
- var prism                 = true;
- var home_slider           = true;

doctype html
html(lang='en')
  include ../../components/header-files
  body
    .loader-wrapper
      .text-center
        img.img-fluid(src='../assets/images/Loader.gif' alt='loader')
      .text-animation
        svg
          text(x='50%' y='50%' dy='.35em' text-anchor='middle')
            | Physic template
    section.login-bg-img.forget-two
      .container-fluid.login-page 
        .row.align-items-center 
          .col-xxl-4.col-md-6.mx-auto
            .login-box
              .login-title
                h4.mb-2 Forgot password
                span Enter Your Email And We'll Send You a Link To Reset Your Password.
              .login-form 
                form.row.g-3
                  .col-12 
                    input.form-control(type='email' placeholder='Name@example.com' value='Test@example.com')
                  .col-12 
                    button.btn.login.sub-btn.sm(type='submit' data-bs-dismiss="modal" aria-label="Close") Send Otp
              .other-login
              .sign-up-box 
                a(href="login.html") Back To LogIn

    include ../../components/footer-files