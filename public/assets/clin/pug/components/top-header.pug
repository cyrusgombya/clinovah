// Top Header Start
header  
    .top-header 
        .custom-container.container 
            .header-items
                .top-header-left
                    a(href="#")
                        i.fa.fa-phone
                        |  800-585-800 / 652-545-526
                    a(href="#")
                        i.fa-regular.fa-clock
                        | We Are Open 24 Hours
                .top-header-right
                    a(href="#") 
                        | How to Find Us
                    a(href="#")
                        | Give Feedback
                    a(href="#")
                        | Request An Appointment
    .main-header
        .custom-container.container
            .row 
                .col-lg-12 
                    .main-menu
                        .menu-left 
                            .brand-logo 
                                a(href="#") 
                                    img.img-fluid(src="../assets/images/logo/logo1.png" alt='Logo')
                        div 
                            nav 
                                .main-navbar
                                    #main-nav 
                                        ul.nav-menu
                                            //- li.back-btn
                                            //-     .mobile-back.text-right
                                            //-         span Back
                                            //-         i.fa.fa-angle-right.pl-2
                                            li 
                                                a.menu-title.active(href="") Home
                                            li 
                                                a.menu-title(href="") Doctor
                                            li 
                                                a.menu-title(href="") Department
                                            li 
                                                a.menu-title(href="") Services
                                            li 
                                                a.menu-title(href="") Event
                                            li 
                                                a.menu-title(href="") Blog
                                            li 
                                                a.menu-title(href="") Contact
                        .menu-right 
                            div 
                                .icon-nav
                                    ul 
                                        li.mobile-search.me-2
                                            a.btn.default-btn(href="")
                                                i.fa.fa-search 
                                        li
                                            button.btn.default-btn(type='button' data-bs-toggle='offcanvas' data-bs-target='#offcanvasRight' aria-controls='offcanvasRight')
                                                i.icon-menu
                                            #offcanvasRight.offcanvas.offcanvas-end(tabindex='-1' aria-labelledby='offcanvasRightLabel')
                                                .offcanvas-header
                                                    h5#offcanvasRightLabel.offcanvas-title Offcanvas right
                                                    button.btn-close(type='button' data-bs-dismiss='offcanvas' aria-label='Close')
                                                .offcanvas-body
                                                    | ...
